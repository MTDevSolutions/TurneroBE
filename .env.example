# Plantilla de variables de produccion de Turnix. Copiar a .env (chmod 600) y completar con valores REALES.
# El .env real NUNCA se sube a git (esta en .gitignore / .dockerignore). Runbook: docs/deploy-vps.md

# --- Postgres ---
POSTGRES_DB=turnix
POSTGRES_USER=postgres
# openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR_password_fuerte

# --- JWT ---
# Minimo 32 caracteres, aleatoria: openssl rand -base64 48
JWT_KEY=CAMBIAR_clave_jwt_larga_y_aleatoria_min_32_chars
JWT_ISSUER=TurnixApi
JWT_AUDIENCE=TurnixClient

# --- CORS ---
# Dominio del front (Vercel). Separar con comas si hay varios (ej. el *.vercel.app mientras se prueba).
CORS_ALLOWED_ORIGIN=https://turnix.mtdevapp.com

# --- CSRF (double-submit) ---
# El front manda X-CSRF-Token: funciona porque Vercel reenvia /api y la cookie queda en el dominio del front.
CSRF_ENABLED=true

# --- Cookies de autenticacion ---
# Front y API en el mismo dominio (rewrite de Vercel): Lax + Secure.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=true

# --- Superadmin de plataforma ---
# Se siembra al arrancar si todavia no existe. La API no arranca con la password de desarrollo.
SUPERADMIN_NOMBRE=Superadmin
SUPERADMIN_EMAIL=CAMBIAR@dominio.com
SUPERADMIN_PASSWORD=CAMBIAR_password_superadmin

# --- WhatsApp (Wabix Gateway, mismo VPS) ---
# URL interna por la red docker de wabix-gateway. Vacia = WhatsApp deshabilitado.
WHATSAPP_GATEWAY_URL=http://gateway:8080
# API key de la empresa "Turnix" en el gateway (POST /api/admin/empresas/{id}/apikey).
WHATSAPP_GATEWAY_API_KEY=CAMBIAR_api_key_de_la_empresa_turnix
# Mismo valor que el webhookSecret del telefono en el gateway: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=CAMBIAR_secreto_del_webhook

# --- Swagger (apagado por defecto) ---
# Con ENABLE_SWAGGER=true queda en https://turnix-api.mtdevapp.com/swagger detras de basic auth.
# Sirve para el alta de cuentas como superadmin mientras no haya panel. Si faltan credenciales, da 503.
ENABLE_SWAGGER=false
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=CAMBIAR_password_swagger
